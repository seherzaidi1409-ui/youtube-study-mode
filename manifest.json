{
  "manifest_version": 3,
  "name": "YouTube Study Mode",
  "version": "1.0.0",
  "description": "Reduces distracting YouTube content during study sessions.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "YouTube Study Mode",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}